    "DuoWall saves the wallpapers you create to your photo library so you can set them as your wallpaper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DuoWall 会把你制作的壁纸保存到照片图库，方便你将其设为墙纸。"
          }
        }
      }
    },
