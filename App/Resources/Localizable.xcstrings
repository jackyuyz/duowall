    "The shortcut couldn't be opened. Follow the manual steps below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开快捷指令。请按照以下手动步骤操作。"
          }
        }
      }
    },
    "Step 1: Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 1 步：打开设置"
          }
        }
      }
    },
    "Step 2: Tap Wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 2 步：点击壁纸"
          }
        }
      }
    },
    "Step 3: Add New Wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 3 步：添加新壁纸"
          }
        }
      }
    },
    "Step 4: Choose from Photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 4 步：从照片中选择"
          }
        }
      }
    },
    "Step 5: Select your DuoWall image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 5 步：选择你的 DuoWall 图像"
          }
        }
      }
    },
    "Close your Duo to see the outer crop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上 Duo 查看外屏裁剪效果"
          }
        }
      }
    },
    "Now open it to see the full wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在打开查看完整壁纸"
          }
        }
      }
    },
    "Photos Access Required": {
      "localizations": {
        "zh-Hans": {
